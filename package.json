{
  "name": "testwale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "verify": "npm run typecheck && npm run lint && npm run test:sources && npm run test:mock-tests && npm run build",
    "test:sources": "node --experimental-strip-types scripts/validate-parse-question-sources.ts",
    "test:launch-baseline": "node scripts/launch-readiness-baseline.mjs",
    "test:launch-load": "node scripts/launch-readiness-load.mjs",
    "test:verify-routes": "node scripts/verify-soft-404.mjs",
    "test:verify-sitemap": "node scripts/verify-sitemap.mjs",
    "test:seo": "node scripts/audit-seo.mjs",
    "test:verify-llms": "node scripts/verify-llms-links.mjs",
    "test:cache-privacy": "node scripts/verify-cache-privacy.mjs",
    "test:request-security": "node --experimental-strip-types lib/requestSecurity.test.ts",
    "test:security-regression": "node --experimental-strip-types lib/securityRegression.test.ts",
    "test:safe-redirect": "node --experimental-strip-types lib/safeRedirect.test.ts",
    "test:auth-security": "node --import ./scripts/test-register.mjs --experimental-strip-types lib/authSecurity.test.ts",
    "test:accessibility": "node --experimental-strip-types lib/accessibilityRegression.test.ts",
    "test:oauth-code-redirect": "node --import ./scripts/test-register.mjs --experimental-strip-types lib/oauthCodeRedirect.test.ts",
    "test:public-origin": "node --experimental-strip-types lib/publicOrigin.test.ts",
    "test:profile-overview": "node --experimental-strip-types lib/profileOverview.test.ts",
    "test:profile-insights": "node --experimental-strip-types lib/profileInsightsCore.test.ts",
    "test:profile-activity": "node --import ./scripts/test-register.mjs --experimental-strip-types lib/profileActivityCore.test.ts",
    "test:profile-saved": "node --import ./scripts/test-register.mjs --experimental-strip-types lib/profileSavedCore.test.ts",
    "test:profile-goals": "node --import ./scripts/test-register.mjs --experimental-strip-types lib/profileGoalsCore.test.ts",
    "test:exam-onboarding": "node --import ./scripts/test-register.mjs --experimental-strip-types lib/examOnboarding.test.ts && node --import ./scripts/test-register.mjs --experimental-strip-types lib/examPreference.test.ts",
    "test:exam-learning": "node --import ./scripts/test-register.mjs --experimental-strip-types lib/examLearning.test.ts",
    "test:ssc-cgl": "node --import ./scripts/test-register.mjs --experimental-strip-types lib/sscCglSyllabus.test.ts && node --import ./scripts/test-register.mjs --experimental-strip-types lib/sscCglPreference.test.ts && node --experimental-strip-types lib/publicExamExplorer.test.ts",
    "test:mock-tests": "node --import ./scripts/test-register.mjs --experimental-strip-types --test lib/mockTests/core.test.ts lib/mockTests/strictVerification.test.ts lib/mockTests/security.test.ts lib/mockTests/showcase.test.ts",
    "test:exam-navigation": "node --import ./scripts/test-register.mjs --experimental-strip-types --test lib/publicExamDirectory.test.ts",
    "test:mock-smoke": "node scripts/smoke-ssc-cgl-mock-routes.mjs",
    "prepare:ssc-cgl-mock-limited": "node --env-file=.env.local --import ./scripts/test-register.mjs --experimental-strip-types scripts/prepare-ssc-cgl-limited-mock.ts",
    "audit:ssc-chsl-mock-strict": "node --env-file=.env.local --experimental-strip-types scripts/strict-verify-ssc-chsl-mock-inventory.ts",
    "prepare:ssc-chsl-mock-strict": "node --env-file=.env.local --experimental-strip-types scripts/prepare-ssc-chsl-strict-inventory.ts",
    "test:ssc-chsl": "node --import ./scripts/test-register.mjs --experimental-strip-types lib/sscChsl.test.ts && node --import ./scripts/test-register.mjs --experimental-strip-types lib/examPreference.test.ts && node --experimental-strip-types lib/publicExamExplorer.test.ts",
    "test:quality-upgrade": "node --experimental-strip-types lib/qualityUpgradeAnnouncement.test.ts",
    "test:seo-policy": "node --import ./scripts/test-register.mjs --experimental-strip-types lib/seoPolicy.test.ts",
    "test:verify-auth": "node scripts/verify-auth-security.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.105.4",
    "@types/leaflet": "^1.9.21",
    "framer-motion": "^12.40.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "next": "16.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "20.14.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "10.4.19",
    "critters": "^0.0.23",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5.18",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.4"
  },
  "overrides": {
    "postcss": "^8.5.18"
  },
  "browserslist": [
    "chrome >= 92",
    "edge >= 92",
    "firefox >= 90",
    "safari >= 15.4",
    "ios >= 15.4"
  ]
}
