# Canonical public origin (no trailing path or slash)
NEXT_PUBLIC_SITE_URL=https://questionwale.com

# Supabase browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Generate independent random values with at least 32 bytes of entropy.
AUTH_SECRET=
RATE_LIMIT_KEY_SECRET=

# Rollout: keep false only while the matching SQL migration is being applied,
# then set true so API traffic fails closed if the distributed limiter is down.
DISTRIBUTED_RATE_LIMIT_REQUIRED=false

# Email/password account verification and recovery delivery webhook.
# Turn verification on only after the HTTPS delivery integration is tested.
REQUIRE_EMAIL_VERIFICATION=false
AUTH_EMAIL_DELIVERY_URL=https://mailer.example.invalid/questionwale-auth
AUTH_EMAIL_DELIVERY_BEARER_TOKEN=

# Google/Supabase OAuth client ID (a client ID is public; client secrets are not).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-to-server cache invalidation secret.
QUESTION_CACHE_REVALIDATE_SECRET=

# Optional search-engine ownership verification token.
GOOGLE_SITE_VERIFICATION=

# Preview/emergency indexing control. Production should leave this unset/false.
QW_FORCE_NOINDEX=false
