# Public (safe for browser)
NEXT_PUBLIC_SITE_URL=https://questionwale.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only — NEVER prefix with NEXT_PUBLIC_
# Optional but recommended for production (bypasses RLS for practice writes)
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SECRET=

# Optional — HMAC secret for practice RPCs when service role is not set (dev uses built-in default)
# Must match practice_server_secrets.signing_secret in Supabase for production
# PRACTICE_SUBMIT_SECRET=

# Optional — server-only secret for manual public question-batch cache invalidation
# (required to call POST /api/admin/revalidate-question-batch after Supabase Dashboard edits)
# QUESTION_CACHE_REVALIDATE_SECRET=

# Optional aliases / legacy names
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_ID_AUTH=
